generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ADVERTISER
  PUBLISHER
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum PricingModel {
  CPC
  CPM
}

enum CreativeType {
  IMAGE
  HTML
  VIDEO
}

enum WebsiteStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PlacementSize {
  LEADERBOARD
  MEDIUM_RECTANGLE
  WIDE_SKYSCRAPER
  MOBILE_BANNER
  CUSTOM
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @default(ADVERTISER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  advertiser Advertiser?
  publisher  Publisher?
  sessions   Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Advertiser {
  id        String     @id @default(cuid())
  userId    String     @unique
  company   String?
  balance   Decimal    @default(0) @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  invoices  Invoice[]
  payments  Payment[]
}

model Publisher {
  id        String    @id @default(cuid())
  userId    String    @unique
  company   String?
  balance   Decimal   @default(0) @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  websites  Website[]
  invoices  Invoice[]
  payments  Payment[]
}

model Website {
  id          String        @id @default(cuid())
  publisherId String
  name        String
  domain      String
  url         String
  status      WebsiteStatus @default(PENDING)
  category    String?
  reviewedAt  DateTime?
  reviewedBy  String?
  rejectReason String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publisher   Publisher     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  placements  Placement[]

  @@unique([publisherId, domain])
  @@index([status])
}

model Campaign {
  id              String         @id @default(cuid())
  advertiserId    String
  name            String
  status          CampaignStatus @default(DRAFT)
  pricingModel    PricingModel
  bidAmount       Decimal        @db.Decimal(10, 4)
  dailyBudget     Decimal?       @db.Decimal(12, 2)
  totalBudget     Decimal?       @db.Decimal(12, 2)
  spent           Decimal        @default(0) @db.Decimal(12, 2)
  priority        Int            @default(5)
  startDate       DateTime?
  endDate         DateTime?
  geoTargets      String[]       @default([])
  deviceTargets   String[]       @default([])
  browserTargets  String[]       @default([])
  frequencyCap    Int?
  frequencyPeriod Int?           // hours
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  advertiser      Advertiser     @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  creatives       Creative[]
  impressions     Impression[]
  clicks          Click[]

  @@index([status, priority])
  @@index([advertiserId])
}

model Creative {
  id         String       @id @default(cuid())
  campaignId String
  name       String
  type       CreativeType @default(IMAGE)
  width      Int?
  height     Int?
  imageUrl   String?
  clickUrl   String
  htmlContent String?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  impressions Impression[]
  clicks     Click[]

  @@index([campaignId])
}

model Placement {
  id          String        @id @default(cuid())
  websiteId   String
  name        String
  size        PlacementSize @default(MEDIUM_RECTANGLE)
  width       Int?
  height      Int?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  website     Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  impressions Impression[]
  clicks      Click[]

  @@index([websiteId])
}

model Impression {
  id          String   @id @default(cuid())
  campaignId  String
  creativeId  String
  placementId String
  country     String?
  device      String?
  browser     String?
  ipHash      String?
  revenue     Decimal  @default(0) @db.Decimal(10, 6)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative    Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([placementId, createdAt])
  @@index([createdAt])
}

model Click {
  id          String   @id @default(cuid())
  campaignId  String
  creativeId  String
  placementId String
  impressionId String?
  country     String?
  device      String?
  browser     String?
  ipHash      String?
  revenue     Decimal  @default(0) @db.Decimal(10, 6)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative    Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([placementId, createdAt])
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String        @unique
  advertiserId String?
  publisherId  String?
  amount       Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(DRAFT)
  periodStart  DateTime
  periodEnd    DateTime
  dueDate      DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  advertiser   Advertiser?   @relation(fields: [advertiserId], references: [id])
  publisher    Publisher?    @relation(fields: [publisherId], references: [id])
  payments     Payment[]
}

model Payment {
  id           String        @id @default(cuid())
  advertiserId String?
  publisherId  String?
  invoiceId    String?
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(PENDING)
  method       String?
  reference    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  advertiser   Advertiser?   @relation(fields: [advertiserId], references: [id])
  publisher    Publisher?    @relation(fields: [publisherId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
}

model FraudEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String
  ipHash    String?
  placementId String?
  campaignId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity])
}
