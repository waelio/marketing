{
    "name": "waelio-marketing",
    "version": "1.0.0",
    "private": true,
    "description": "Waelio Marketing - advertising network for publishers and advertisers",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev --parallel",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:seed": "tsx scripts/seed.ts",
        "postinstall": "prisma generate",
        "db:studio": "prisma studio",
        "prepare": "husky"
    },
    "dependencies": {
        "@prisma/client": "^6.1.0",
        "bcryptjs": "^2.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.16.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22.10.0",
        "typescript-eslint": "^8.18.0",
        "eslint": "^9.16.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.11",
        "prettier": "^3.4.2",
        "prisma": "^6.1.0",
        "tsx": "^4.19.2",
        "turbo": "^2.3.3",
        "typescript": "^5.7.2"
    },
    "engines": {
        "node": ">=20"
    },
    "packageManager": "npm@10.9.0",
    "lint-staged": {
        "*.{ts,tsx,js,json,md}": [
            "prettier --write"
        ]
    }
}
