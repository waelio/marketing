{
    "name": "@waelio/marketing",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "npm --workspace @waelio/web dev",
        "dev:api": "npm --workspace @waelio/api dev",
        "dev:admin": "npm --workspace @waelio/admin dev",
        "dev": "npm run dev:web",
        "build": "npm run build --workspaces",
        "lint": "npm run lint --workspaces"
    }
}